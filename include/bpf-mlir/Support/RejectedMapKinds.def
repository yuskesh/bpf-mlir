// Deliberately unsupported kernel map kinds, with reasons and optional
// replacements, shared by schema parsing and operation verification.
// Every row needs evidence: a kernel source location or measured result.
// The developer TestRejectedMapKinds rejects missing evidence, names outside
// UAPI, contradictions with accepted MapKinds and nonexistent replacements.
// EBPF_REJECTED_MAP_KIND(NAME, UAPI, REASON, REPLACEMENT, NOTE, EXPERIMENT, EVIDENCE):
// NAME is the schema/map type spelling; UAPI names enum bpf_map_type;
// REASON is deprecated or loader-generated; REPLACEMENT is an accepted map kind
// (empty for loader-generated); NOTE is optional diagnostic prose; EXPERIMENT
// is a diagnostic provenance label; EVIDENCE records the rejection basis.
// clang-format off
#ifndef EBPF_REJECTED_MAP_KIND
#error "define EBPF_REJECTED_MAP_KIND(NAME, UAPI, REASON, REPLACEMENT, NOTE, EXPERIMENT, EVIDENCE) before including RejectedMapKinds.def"
#endif

// Legacy cgroup-only local storage is kernel-deprecated; cgrp_storage
// provides its functionality.
EBPF_REJECTED_MAP_KIND("cgroup_storage", "BPF_MAP_TYPE_CGROUP_STORAGE", "deprecated", "cgrp_storage",
                       "BPF_MAP_TYPE_CGRP_STORAGE — cgroup local storage, ebpf.storage.get / ebpf.storage.delete with the cgroup as the owner",
                       "kernel-source audit",
                       "include/uapi/linux/bpf.h note (7.1.8:1020-1026 — deprecated because CGRP_STORAGE provides all CGROUP_STORAGE functionality)")
EBPF_REJECTED_MAP_KIND("cgroup_storage_deprecated", "BPF_MAP_TYPE_CGROUP_STORAGE_DEPRECATED", "deprecated", "cgrp_storage",
                       "BPF_MAP_TYPE_CGRP_STORAGE — cgroup local storage, ebpf.storage.get / ebpf.storage.delete with the cgroup as the owner",
                       "kernel-source audit",
                       "include/uapi/linux/bpf.h (7.1.8:1019 — alias for BPF_MAP_TYPE_CGROUP_STORAGE, value 19; note at 1020-1026)")
// The kernel replacement for the percpu variant is cgrp_storage plus a local
// percpu kptr, which this compiler does not support.
EBPF_REJECTED_MAP_KIND("percpu_cgroup_storage", "BPF_MAP_TYPE_PERCPU_CGROUP_STORAGE", "deprecated", "cgrp_storage",
                       "BPF_MAP_TYPE_CGRP_STORAGE — cgroup local storage; the kernel's replacement is cgrp_storage plus a local percpu kptr, and this compiler has no percpu kptr, so \"cgrp_storage\" gives one value per cgroup, not per CPU",
                       "kernel-source audit",
                       "include/uapi/linux/bpf.h note (7.1.8:1029-1035 — deprecated because CGRP_STORAGE + local percpu kptr provides all functionality)")
EBPF_REJECTED_MAP_KIND("percpu_cgroup_storage_deprecated", "BPF_MAP_TYPE_PERCPU_CGROUP_STORAGE_DEPRECATED", "deprecated", "cgrp_storage",
                       "BPF_MAP_TYPE_CGRP_STORAGE — cgroup local storage; the kernel's replacement is cgrp_storage plus a local percpu kptr, and this compiler has no percpu kptr, so \"cgrp_storage\" gives one value per cgroup, not per CPU",
                       "kernel-source audit",
                       "include/uapi/linux/bpf.h (7.1.8:1028 — alias for BPF_MAP_TYPE_PERCPU_CGROUP_STORAGE, value 21; note at 1029-1035)")
// libbpf converts ELF .jumptables into program-private maps; there is no
// equivalent ordinary user map.
EBPF_REJECTED_MAP_KIND("insn_array", "BPF_MAP_TYPE_INSN_ARRAY", "loader-generated", "",
                       ".jumptables maps are generated by libbpf for indirect jumps; no ordinary map replacement", "kernel-source audit",
                       "tools/lib/bpf/libbpf.c create_jt_map (7.1.8:6309-6390); kernel/bpf/bpf_insn_array.c freeze/offset/one-program (158-207)")
// clang-format on
#undef EBPF_REJECTED_MAP_KIND
