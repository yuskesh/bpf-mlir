// Canonical allowed schema keys per object. docs/schema_format.md is checked
// bidirectionally by go/internal/schemaspec. requireOnlyKeys consumes only
// this table; add keys and specification rows in the same commit.
// SCHEMA_OBJECT(<id>, "<object path>", "<key>", ...)
SCHEMA_OBJECT(TypeInt, "type(int)", "kind", "bits", "signed", "endianness", "alignment")
SCHEMA_OBJECT(TypeArray, "type(array)", "kind", "count", "element")
SCHEMA_OBJECT(TypeSpinLock, "type(spin_lock)", "kind")
SCHEMA_OBJECT(TypeTimer, "type(timer)", "kind")
SCHEMA_OBJECT(TypeStackBuildId, "type(stack_build_id)", "kind")
SCHEMA_OBJECT(TypeRecordRef, "type(record_ref)", "kind", "symbol")
// Map-value kptr record fields. Do not add trailing comments: ReadTable
// accepts only table rows ending in ')'.
SCHEMA_OBJECT(TypeKptr, "type(kptr)", "kind", "struct")
SCHEMA_OBJECT(PredOperand, "predicate.operand", "kind", "name")
SCHEMA_OBJECT(Predicate, "predicate", "op", "operand", "index", "bytes", "args", "detail")
SCHEMA_OBJECT(Source, "source", "kind", "name", "from", "detail")
SCHEMA_OBJECT(Root, "schema", "version", "coverage", "core", "telemetry", "extensions")
SCHEMA_OBJECT(Coverage, "coverage", "programs", "maps", "records", "telemetry")
SCHEMA_OBJECT(Core, "core", "programs", "maps", "records", "kernel_types", "globals")
SCHEMA_OBJECT(Record, "core.records[]", "symbol", "id", "size", "min_size", "alignment", "required_through", "fields", "note")
SCHEMA_OBJECT(RecordField, "core.records[].fields[]", "name", "type", "offset", "expose", "note")
SCHEMA_OBJECT(KernelType, "core.kernel_types[]", "name", "fields", "note")
SCHEMA_OBJECT(KernelField, "core.kernel_types[].fields[]", "name", "type", "note")
SCHEMA_OBJECT(KernelStruct, "core.kernel_types[].fields[].type(struct)", "kind", "struct")
SCHEMA_OBJECT(Map, "core.maps[]", "symbol", "kind", "key", "value", "max_entries", "flags", "record", "note", "slots", "struct_ops", "inner")
SCHEMA_OBJECT(MapSlot, "core.maps[].slots[]", "index", "program")
SCHEMA_OBJECT(MapStructOps, "core.maps[].struct_ops", "type", "name", "ops")
SCHEMA_OBJECT(MapStructOpsOp, "core.maps[].struct_ops.ops[]", "member", "program")
SCHEMA_OBJECT(Program, "core.programs[]", "name", "kind", "attach_target", "maps", "args", "nargs", "ret", "arch", "params", "target_params", "binary_sha256", "fields", "semaphore", "max_points", "note")
SCHEMA_OBJECT(ProgramField, "core.programs[].fields[]", "name", "offset", "type")
SCHEMA_OBJECT(ProgramFieldUserStr, "core.programs[].fields[].type(user_str)", "kind")
SCHEMA_OBJECT(ProgramFieldUserStrArray, "core.programs[].fields[].type(user_str_array)", "kind")
SCHEMA_OBJECT(ProgramFieldArray, "core.programs[].fields[].type(array)", "kind", "elem", "n")
SCHEMA_OBJECT(ProgramParam, "core.programs[].params[]", "n", "type")
// this existing object is also the typed ksyscall char-pointer parameter; no extra keys.
SCHEMA_OBJECT(ProgramParamUserStr, "core.programs[].params[].type(user_str)", "kind")
SCHEMA_OBJECT(ProgramParamUserBuf, "core.programs[].params[].type(user_buf)", "kind")
SCHEMA_OBJECT(ProgramParamUserStrArray, "core.programs[].params[].type(user_str_array)", "kind")
SCHEMA_OBJECT(ProgramParamPtr, "core.programs[].params[].type(ptr)", "kind")
SCHEMA_OBJECT(Global, "core.globals[]", "name", "section", "type", "note")
SCHEMA_OBJECT(Telemetry, "telemetry", "signals", "clocks", "value_maps", "bounds_sets")
SCHEMA_OBJECT(Clock, "telemetry.clocks[]", "id", "kernel_source", "posix_clock", "to_wall", "note")
SCHEMA_OBJECT(ValueMap, "telemetry.value_maps[]", "id", "unknown", "arch_invariant", "btf_mode", "btf_anchor", "btf_prefix", "btf_omit", "authority", "note", "entries")
SCHEMA_OBJECT(ValueMapEntry, "telemetry.value_maps[].entries[]", "value", "name")
SCHEMA_OBJECT(BoundsSet, "telemetry.bounds_sets[]", "id", "bounds", "unit", "authority", "note")
SCHEMA_OBJECT(Signal, "telemetry.signals[]", "name", "signal", "record", "span_name", "span_kind", "timing", "drop_when", "attributes", "body", "value", "metric", "note")
SCHEMA_OBJECT(SignalTiming, "telemetry.signals[].timing", "start", "clock", "end")
SCHEMA_OBJECT(Metric, "telemetry.signals[].metric", "kind", "unit", "temporality", "monotonic", "scale", "zero_threshold", "bucket_rule")
SCHEMA_OBJECT(Attribute, "telemetry.signals[].attributes[]", "key", "stability", "source", "presence", "note")
