#!/bin/bash
# gen-version <output-header> [source-directory] writes git describe/commit for
# ebpf-compile --version, never ELF bytes, preserving reproducible ELF output.
# Leave identical contents untouched to avoid rebuilding. Without Git, or when
# source is not its realpath-resolved Git toplevel, report unknown rather than
# borrowing a parent repository's version. Submodules have their own toplevel.
# The optional source directory is a test seam; default is this script's repo.
set -uo pipefail
OUT=${1:?output header}
REPO=$(realpath "${2:-$(dirname "$0")/..}")
if [ "${3:-}" = --distribution ]; then
  META_FILE="$REPO/SOURCE_VERSION"
  if [ ! -f "$META_FILE" ] || [ "$(wc -l < "$META_FILE")" -ne 3 ]; then
    echo "SOURCE_VERSION: missing or invalid release metadata" >&2; exit 1
  fi
  META=$(awk '
    NR == 1 { if ($0 != "format=1") exit 1 }
    NR == 2 { if ($0 !~ /^version=(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$/) exit 1; sub(/^version=/, ""); version=$0 }
    NR == 3 { if (length($0) != 54 || $0 !~ /^source_commit=[0-9a-f]+$/) exit 1; sub(/^source_commit=/, ""); sha=$0 }
    END { if (NR != 3 || version == "" || sha == "") exit 1; print "v" version; print sha }
  ' "$META_FILE") || { echo "SOURCE_VERSION: invalid format, version or source_commit" >&2; exit 1; }
  DESC=$(printf '%s\n' "$META" | head -n 1)
  SHA=$(printf '%s\n' "$META" | tail -n 1)
elif [ -n "${3:-}" ]; then
  echo "gen-version: unknown mode" >&2; exit 1
else
TOP=$(git -C "$REPO" rev-parse --show-toplevel 2>/dev/null) && TOP=$(realpath "$TOP")
if [ "${TOP:-}" = "$REPO" ]; then
  DESC=$(git -C "$REPO" describe --tags --match 'go/v*' --dirty --always 2>/dev/null) || DESC=unknown
  SHA=$(git -C "$REPO" rev-parse HEAD 2>/dev/null) || SHA=unknown
else
  DESC=unknown; SHA=unknown
fi
fi
[ -n "$DESC" ] || DESC=unknown
[ -n "$SHA" ] || SHA=unknown
TMP=$(mktemp)
cat > "$TMP" <<H
// Generated by scripts/gen-version. Do not edit.
#define BPF_MLIR_DESCRIBE "$DESC"
#define BPF_MLIR_COMMIT "$SHA"
H
mkdir -p "$(dirname "$OUT")"
if cmp -s "$TMP" "$OUT"; then rm -f "$TMP"; else mv "$TMP" "$OUT"; fi
