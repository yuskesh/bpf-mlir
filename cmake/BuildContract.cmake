# Shared by configuration and the small script-mode contract controls.
function(bpf_mlir_check_toolchain llvm_version mlir_version)
  if(NOT "${llvm_version}" STREQUAL "23.1.1" OR NOT "${mlir_version}" STREQUAL "23.1.1")
    message(FATAL_ERROR "bpf-mlir requires LLVM/MLIR 23.1.1 (LLVM=${llvm_version}, MLIR=${mlir_version})")
  endif()
endfunction()

function(bpf_mlir_check_distribution_tests)
  if(NOT BPF_MLIR_DISTRIBUTION OR NOT BPF_MLIR_BUILD_TESTS)
    return()
  endif()
  if(NOT LLVM_EXTERNAL_LIT OR NOT EXISTS "${LLVM_EXTERNAL_LIT}")
    message(FATAL_ERROR "distribution tests require explicit LLVM_EXTERNAL_LIT (lit 23.1.1)")
  endif()
  if(NOT BPF_MLIR_PYTHON OR NOT EXISTS "${BPF_MLIR_PYTHON}")
    message(FATAL_ERROR "distribution tests require explicit BPF_MLIR_PYTHON (Python 3)")
  endif()
  execute_process(COMMAND "${LLVM_EXTERNAL_LIT}" --version RESULT_VARIABLE lit_rc OUTPUT_VARIABLE lit_out ERROR_VARIABLE lit_err)
  string(STRIP "${lit_out}" lit_out)
  if(NOT lit_rc EQUAL 0 OR NOT lit_out STREQUAL "lit 23.1.1")
    message(FATAL_ERROR "distribution tests require lit 23.1.1: ${lit_out}${lit_err}")
  endif()
  execute_process(COMMAND "${BPF_MLIR_PYTHON}" --version RESULT_VARIABLE python_rc OUTPUT_VARIABLE python_out ERROR_VARIABLE python_err)
  if(NOT python_rc EQUAL 0 OR NOT "${python_out}${python_err}" MATCHES "^Python 3\\.")
    message(FATAL_ERROR "BPF_MLIR_PYTHON must run Python 3")
  endif()
endfunction()
